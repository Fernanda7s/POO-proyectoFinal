<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="662.0" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.controller.BuscarProductoController">
    <children>
        <VBox layoutX="10.0" layoutY="10.0" prefHeight="580.0" prefWidth="641.0" spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="lblTitulo" text="CATÁLOGO DE PRODUCTOS" />

                <VBox prefHeight="160.0" prefWidth="601.0" spacing="12.0" styleClass="contenedor">
                    <children>
                        <Label styleClass="titulo-seccion" text="BÚSQUEDA DE PRODUCTO" />
                        <GridPane hgap="15.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="24.0" prefHeight="24.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="34.0" prefHeight="34.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label styleClass="lbl-campo" text="Nombre" />
                                <Label styleClass="lbl-campo" text="Marca" GridPane.columnIndex="1" />
                                <TextField fx:id="txtNombre" promptText="Ingrese nombre del producto" styleClass="txt-campo" GridPane.rowIndex="1" />
                                <TextField fx:id="txtMarca" promptText="Ingrese marca" styleClass="txt-campo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#onBuscarClick" styleClass="btn-buscar" text="BUSCAR" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="8.0" />
                            </padding>
                        </GridPane>
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                </VBox>

                <VBox prefHeight="340.0" prefWidth="601.0" spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="titulo-seccion" text="PRODUCTOS DISPONIBLES" />
                        <TableView fx:id="tablaProductos" prefHeight="310.0" prefWidth="601.0" styleClass="tabla-productos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="60.0" styleClass="tabla-productos" text="ID" />
                                <TableColumn fx:id="colCodigo" prefWidth="69.0" styleClass="tabla-productos" text="Código" />
                                <TableColumn fx:id="colNombre" prefWidth="135.0" styleClass="tabla-productos" text="Nombre" />
                                <TableColumn fx:id="colMarca" prefWidth="106.0" styleClass="tabla-productos" text="Marca" />
                                <TableColumn fx:id="colPrecio" prefWidth="71.0" styleClass="tabla-productos" text="Precio" />
                                <TableColumn fx:id="colStock" minWidth="0.0" prefWidth="70.0" styleClass="tabla-productos" text="Stock" />
                                <TableColumn fx:id="colCatalogo" prefWidth="109.0" styleClass="tabla-productos" text="Catálogo" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
