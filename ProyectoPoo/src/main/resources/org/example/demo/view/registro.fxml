<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="tablaRegistro" prefHeight="500.0" prefWidth="428.0" styleClass="tablaRegistro" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.controller.RegistroController">
   <children>
      <Label layoutX="155.0" layoutY="15.0" text="REGISTRO DE USUARIO">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>

      <Label layoutX="50.0" layoutY="60.0" text="Nombre:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtNombre" layoutX="130.0" layoutY="55.0" prefHeight="30.0" prefWidth="240.0" />

      <Label layoutX="50.0" layoutY="105.0" text="Apellido:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtApellido" layoutX="130.0" layoutY="100.0" prefHeight="30.0" prefWidth="240.0" />

      <Label layoutX="50.0" layoutY="150.0" text="Usuario:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtUsuarioRegistro" layoutX="130.0" layoutY="145.0" prefHeight="30.0" prefWidth="240.0" />

      <Label layoutX="50.0" layoutY="195.0" text="Contraseña:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <PasswordField fx:id="txtContrasenia" layoutX="140.0" layoutY="190.0" prefHeight="26.0" prefWidth="230.0" />

      <Label layoutX="50.0" layoutY="235.0" text="Confirmar:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <PasswordField fx:id="txtRepContrasenia" layoutX="140.0" layoutY="230.0" prefHeight="26.0" prefWidth="230.0" promptText="vuelve a escribir la contraseña" />

      <Label fx:id="lblMensaje" layoutX="130.0" layoutY="275.0" />

      <Button fx:id="btnRegistrar" layoutX="80.0" layoutY="315.0" mnemonicParsing="false" onAction="#onRegistrar" styleClass="btnRegistrar" stylesheets="@../css/estilos.css" text="Registrar" prefHeight="35.0" prefWidth="120.0" />
      <Button fx:id="btnSalir" layoutX="230.0" layoutY="315.0" mnemonicParsing="false" onAction="#onSalir" styleClass="btnSalir" stylesheets="@../css/estilos.css" text="Salir" prefHeight="35.0" prefWidth="120.0" textFill="WHITE" />
   </children>
</AnchorPane>