<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="544.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.controller.administradorEmpleadosController">
    <children>
        <Pane fx:id="panelPersonas" layoutY="-2.0" prefHeight="546.0" prefWidth="155.0" styleClass="panelPersonas" stylesheets="@../css/estilos.css">
            <children>
                <Label layoutX="10.0" layoutY="58.0" text="ADMINISTRADOR">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font></Label>
            </children></Pane>
        <Button fx:id="btnIrProductos" layoutX="20.0" layoutY="110.0" prefHeight="35.0" prefWidth="120.0" onAction="#abrirProductos" text="PRODUCTOS" styleClass="btnIngreso" stylesheets="@../css/estilos.css" />
        <TextField fx:id="txtCodigoEpd" layoutX="256.0" layoutY="56.0" prefHeight="26.0" prefWidth="209.0" promptText="Ingrese el codigo" />
        <TextField fx:id="txtNombreEpd" layoutX="262.0" layoutY="103.0" prefHeight="26.0" prefWidth="197.0" promptText="Ingrese el nombre" />
        <TextField fx:id="txtApellidoEpd" layoutX="262.0" layoutY="151.0" prefHeight="26.0" prefWidth="198.0" promptText="Ingrese el apelido" />
        <ComboBox fx:id="cbxCargoEmp" layoutX="262.0" layoutY="203.0" prefHeight="26.0" prefWidth="198.0" promptText="eliga el cargo" />
        <Label layoutX="206.0" layoutY="14.0" text="AMINISTRACION DE EMPLEADOS">
            <font>
                <Font name="System Bold" size="22.0" />
            </font></Label>
        <Button fx:id="btnCrearEmp" layoutX="206.0" layoutY="256.0" mnemonicParsing="false" onAction="#onCrearEmp" text="Crear" />
        <Button fx:id="btnActualizarEmp" layoutX="336.0" layoutY="256.0" mnemonicParsing="false" onAction="#onActualizarEmp" text="Actualizar" />
        <Button fx:id="btnBuscarEmp" layoutX="494.0" layoutY="82.0" mnemonicParsing="false" onAction="#onBuscarEmp" text="Buscar" />
        <Button fx:id="btnEliminarEmp" layoutX="499.0" layoutY="256.0" mnemonicParsing="false" text="Eliminar" />
        <TableView fx:id="tblEmpleados" layoutX="186.0" layoutY="330.0" prefHeight="200.0" prefWidth="449.0">
            <columns>
                <TableColumn fx:id="clmCodigoEmp" prefWidth="75.0" text="CODIGO" />
                <TableColumn fx:id="clmNombreEmp" prefWidth="75.0" text="NOMBRE" />
                <TableColumn fx:id="clmApellidoEmp" prefWidth="75.0" text="APELLIDO" />
                <TableColumn fx:id="clmCargoEmp" prefWidth="75.0" text="CARGO" />
                <TableColumn fx:id="clmUsuarioEmp" prefWidth="75.0" text="USUARIO" />
                <TableColumn fx:id="clmClaveEmp" prefWidth="75.0" text="CLAVE" />
            </columns>
        </TableView>
        <Label layoutX="186.0" layoutY="61.0" text="Codigo">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <Label layoutX="182.0" layoutY="107.0" text="Nombre">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <Label layoutX="182.0" layoutY="155.0" text="Apellido">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <Label layoutX="182.0" layoutY="207.0" text="Cargo">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <Button fx:id="btnSalirEmp" layoutX="596.0" layoutY="292.0" mnemonicParsing="false" text="Salir" />
      <Label layoutX="192.0" layoutY="165.0">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Label fx:id="lblMensaje" layoutX="297.0" layoutY="296.0" />
    </children>
</AnchorPane>
